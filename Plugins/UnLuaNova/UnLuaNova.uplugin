{
    "FileVersion": 3,
    "Version": 1,
    "VersionName": "1.0.0",
    "FriendlyName": "UnLuaNova",
    "Description": "Lua / Luau scripting for Unreal Engine: reflection interop, blueprint overrides, static binding, hot reload, diagnostics and declarative networking (experimental). Community continuation of Tencent/UnLua. Verified on UE 5.8 / 6.0 Win64; see the engine support matrix in the documentation.",
    "Category": "Scripting",
    "CreatedBy": "UnLuaNova contributors (forked from Tencent/UnLua)",
    "CreatedByURL": "https://github.com/HUSTJJD/UnLuaNova",
    "DocsURL": "https://hustjjd.github.io/UnLuaNova/",
    "MarketplaceURL": "",
    "SupportURL": "https://github.com/HUSTJJD/UnLuaNova/issues",
    "CanContainContent": true,
    "IsBetaVersion": false,
    "Installed": false,
    "CanBeUsedWithUnrealHeaderTool": true,
    "LocalizationTargets": [
        {
            "Name": "UnLuaNova",
            "LoadingPolicy": "Editor"
        }
    ],
    "Modules": [
        {
            "Name": "UnLuaNova",
            "Type": "Runtime",
            "LoadingPhase": "PreDefault",
            "PlatformAllowList": [ "Win64", "Mac", "IOS", "Android", "Linux" ]
        },
        {
            "Name": "UnLuaNovaEditor",
            "Type": "Editor",
            "LoadingPhase": "Default",
            "PlatformAllowList": [ "Win64", "Mac" ]
        }
    ]
}
