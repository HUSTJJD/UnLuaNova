[submodule "Plugins/UnLuaNova/Source/ThirdParty/LuaLib/Lua"]
	path = Plugins/UnLuaNova/Source/ThirdParty/LuaLib/Lua
	url = https://github.com/lua/lua.git
	branch = master
	# The wrapper writes a .ubtignore into the checkout (see Lua.Build.cs) so UBT does not
	# compile lua.c/luac.c/onelua.c directly. Without this the submodule is permanently
	# "modified (untracked content)" in the superproject.
	ignore = untracked
[submodule "Plugins/UnLuaNova/Source/ThirdParty/LuauLib/Luau"]
	path = Plugins/UnLuaNova/Source/ThirdParty/LuauLib/Luau
	url = https://github.com/luau-lang/luau.git
	branch = master
	# Same as above: Luau.Build.cs generates a .ubtignore so UBT only builds the wrappers
	# in LuauLib/Generated and not Analysis/, CLI/, tests/ etc.
	ignore = untracked
	# luau-analyze (the Luau backend's static checker) is part of this submodule -
	# CLI/src/Analyze.cpp - but UBT excludes CLI/, so Tools/Build-LuauAnalyze.ps1
	# builds just the Luau.Analyze.CLI target with cmake. No separate dependency.
[submodule "Tools/lua-language-server"]
	path = Tools/lua-language-server
	url = https://github.com/LuaLS/lua-language-server.git
	branch = master
	# The Lua backend's static checker (Tools/CheckLuaTypes.ps1). Same arrangement as the
	# two submodules above: the superproject records one commit, and `git submodule update
	# --remote` is what moves it to the tip of master.
	# A tool, not a library to link - it lives under Tools/ so UBT never sees it.
	# Build: Tools/Build-LuaLS.ps1 (needs Ninja + MSVC). It also has 21 nested submodules
	# (3rd/* for the build, meta/3rd/* for other frameworks' API metadata); the build
	# script pulls them. bin/, build/, log/ and meta/ are build output.
	ignore = untracked
[submodule "Tools/luau-lsp"]
	path = Tools/luau-lsp
	url = https://github.com/JohnnyMorganz/luau-lsp.git
	branch = main
	# The Luau backend's static checker (Tools/CheckLuauTypes.ps1), and the counterpart of
	# Tools/lua-language-server above: a tool, not a library to link, so UBT never sees it.
	# luau-analyze (Luau's own CLI) dropped --defs, which leaves the editor's UnLuaNova.d.lua
	# with no way in; `luau-lsp analyze --definitions` reads the very same file. It carries one
	# nested submodule of its own (luau/), which the build script pulls.
	# Build: Tools/Build-LuauLsp.ps1 (needs cmake + MSVC). build/ is build output.
	ignore = untracked
