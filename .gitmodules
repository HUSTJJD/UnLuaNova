[submodule "Plugins/UnLuaNova/Source/ThirdParty/LuaLib/Lua"]
	path = Plugins/UnLuaNova/Source/ThirdParty/LuaLib/Lua
	url = https://github.com/lua/lua.git
	branch = master
	# The wrapper writes a .ubtignore into the checkout (see Lua.Build.cs) so UBT does not
	# compile lua.c/luac.c/onelua.c directly. Without this the submodule is permanently
	# "modified (untracked content)" in the superproject.
	ignore = untracked
[submodule "Plugins/UnLuaNova/Source/ThirdParty/LuauLib/Luau"]
	path = Plugins/UnLuaNova/Source/ThirdParty/LuauLib/Luau
	url = https://github.com/luau-lang/luau.git
	branch = master
	# Same as above: Luau.Build.cs generates a .ubtignore so UBT only builds the wrappers
	# in LuauLib/Generated and not Analysis/, CLI/, tests/ etc.
	ignore = untracked
	# Luau's own CLI is in here too (CLI/src/Analyze.cpp), but UBT excludes CLI/ and it is no
	# longer what checks this project: upstream deleted its --defs, so the Luau backend runs
	# luau-lsp instead - Tools/luau-lsp, built by Tools/Build-LuauLsp.ps1. Build the vendored
	# luau-analyze by hand (cmake --target Luau.Analyze.CLI) if you ever want it back.
